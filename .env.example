# =============================================================================
# HireMind — environment variables
# =============================================================================
# Copy this file, fill in real values, and never commit the result:
#
#   cp .env.example .env               # scraper / python scripts (repo root)
#   cp .env.example frontend/.env.local  # Next.js app (keep only NEXT_PUBLIC_*)
#
# Both .env and .env.local are gitignored. This template must stay
# placeholders-only — it IS committed.
#
# Each variable below is tagged with where it has to be set in production.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. FRONTEND  →  Vercel  (Project → Settings → Environment Variables)
# -----------------------------------------------------------------------------
# Locally these belong in  frontend/.env.local
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time. That means
#   a) never put a secret behind this prefix — it ships to the browser, and
#   b) changing one in Vercel requires a redeploy, not just a restart.
#
# Set all three for Production, Preview and Development.

# Supabase project REST URL. Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. Dashboard → Settings → API → Project API keys.
# Public by design: it is safe in the browser ONLY because row level security
# is enforced on every table. Never substitute the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL — not required for the initial deploy.
# Leave this UNSET until the resume-matcher service is actually hosted. When it
# is unset the client falls back to http://localhost:8000, which a browser on an
# HTTPS page blocks as mixed content, so the resume scanner on the landing page
# will error for visitors. Everything else (jobs, companies, auth, saved jobs)
# works fine without it.
#
# Base origin of the resume-matcher FastAPI service — no path, no trailing slash.
# The client appends /api/parser itself (a trailing slash or a trailing
# /api/parser is tolerated and stripped, but the bare origin is canonical).
# Must be HTTPS in production or the browser blocks it as mixed content.
# Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_RESUME_PARSER_URL=https://your-resume-matcher-host.example.com


# -----------------------------------------------------------------------------
# 2. SCRAPER  →  GitHub Actions  (Repo → Settings → Secrets and variables →
#                                 Actions → New repository secret)
# -----------------------------------------------------------------------------
# Consumed by run_jobs_supabase.py and check_feedback.py, and wired into
# .github/workflows/daily_job.yml. Secret names must match EXACTLY —
# a missing secret resolves to an empty string and the job fails at connect.
#
# Locally these belong in  .env  at the repo root (loaded by python-dotenv).

# Same Supabase project URL as above, without the NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVICE ROLE key — Dashboard → Settings → API → service_role.
# ***SECRET.*** This key BYPASSES row level security entirely. It belongs only
# in GitHub Actions secrets and your local .env — never in frontend/.env.local,
# never in a NEXT_PUBLIC_ variable, never committed.
# The scraper needs it to upsert into `jobs` and prune rows older than 7 days.
SUPABASE_KEY=your-service-role-key


# -----------------------------------------------------------------------------
# 3. RESUME MATCHER  →  container host (Render / Cloud Run / Railway / AWS)
# -----------------------------------------------------------------------------
# Set in that host's own environment settings — NOT in Vercel and NOT in
# GitHub Actions. Read by resume-matcher/main.py.
#
# Locally: resume-matcher/.env, or export it before `uvicorn main:app`.

# ***SECRET.*** Optional. With it, resumes are scored by gpt-4o-mini and the
# response includes predicted roles, extracted keywords and missing skills.
# Without it the service silently falls back to rule-based scoring only —
# no error, just a weaker result.
OPENAI_API_KEY=sk-your-openai-api-key
